# clang-tidy for plumbcheck: every bugprone, cppcoreguidelines and performance check is on,
# except where the check is wrong for any code, not just for today's:
# - unchecked container access, constant array index: the only fix, .at(), puts a bounds
#   check into hot loops;
# - std-namespace-modification: std::ranges::enable_borrowed_range must be specialized in std;
# - easily-swappable-parameters: a heuristic without a clear fix.
# tests/ and profiling/ turn off three more in their own files.
Checks: >
  -*,
  bugprone-*,
  cppcoreguidelines-*,
  performance-*,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -bugprone-std-namespace-modification,
  -bugprone-easily-swappable-parameters
HeaderFilterRegex: '.*/(include/yggdrasil|tests|profiling|python/src)/.*'
ExcludeHeaderFilterRegex: '.*/(dependencies-install|dependencies-build|build|site-packages|_deps)/.*'
CheckOptions:
  # Member initializers are written `= value`, as elsewhere in the code.
  cppcoreguidelines-use-default-member-init.UseAssignment: true
  # Copying a reference-counted handle has a side effect (the count); it is not a wasted copy.
  performance-unnecessary-copy-initialization.AllowedTypes: 'SharedObjectPoolPtr'
