@PACKAGE_INIT@

# Package configuration for the yggdrasil library bundled in the pyyggdrasil
# wheel. Installed to <pyyggdrasil>/lib/cmake/yggdrasil/.
#
# Its dependencies come from pyurd: urd and the native libraries pyurd ships.
# pyurd's prefix must be on CMAKE_PREFIX_PATH (a consumer's build backend lists
# pyurd among its providers; a CMake build calls
# brokkr_find_python_native_prefix(pyurd URD_NATIVE_PREFIX)).

set_and_check(_yggdrasil_prefix "@PACKAGE_YGGDRASIL_PACKAGE_ROOT@")

if(NOT EXISTS "${_yggdrasil_prefix}/include/yggdrasil")
    set(yggdrasil_FOUND FALSE)
    set(yggdrasil_NOT_FOUND_MESSAGE "yggdrasil headers not found under ${_yggdrasil_prefix}/include")
    return()
endif()

include(CMakeFindDependencyMacro)

# urd, with cista, gtl, fmt and Boost's containers. pyurd builds cista without
# CISTA_FMT, so its target defines only CISTA_FNV1A, cista's default hash.
find_dependency(urd CONFIG)
# urd_DIR is <pyurd>/lib/cmake/urd: the other dependencies are pyurd's too, and
# ABI-matched to its shared libraries, so they are resolved from there only.
cmake_path(GET urd_DIR PARENT_PATH _yggdrasil_urd_prefix)
cmake_path(GET _yggdrasil_urd_prefix PARENT_PATH _yggdrasil_urd_prefix)
cmake_path(GET _yggdrasil_urd_prefix PARENT_PATH _yggdrasil_urd_prefix)

# boost_locale-config.cmake resolves ICU through FindICU, a find-module: it never
# sees the PATHS/NO_DEFAULT_PATH below and would search default paths, silently
# picking a system ICU on Linux and finding none at all on macOS. These are the
# cache entries it looks for, so filling them in leaves it nothing to search.
find_path(ICU_INCLUDE_DIR NAMES unicode/utypes.h PATHS "${_yggdrasil_urd_prefix}/include" NO_DEFAULT_PATH REQUIRED)
find_library(ICU_UC_LIBRARY_RELEASE NAMES icuuc PATHS "${_yggdrasil_urd_prefix}/lib" NO_DEFAULT_PATH REQUIRED)
find_library(ICU_I18N_LIBRARY_RELEASE NAMES icui18n PATHS "${_yggdrasil_urd_prefix}/lib" NO_DEFAULT_PATH REQUIRED)
find_library(ICU_DATA_LIBRARY_RELEASE NAMES icudata PATHS "${_yggdrasil_urd_prefix}/lib" NO_DEFAULT_PATH REQUIRED)

find_dependency(Boost CONFIG COMPONENTS headers json locale PATHS "${_yggdrasil_urd_prefix}" NO_DEFAULT_PATH)
find_dependency(fmt CONFIG PATHS "${_yggdrasil_urd_prefix}" NO_DEFAULT_PATH)
find_dependency(gtl CONFIG PATHS "${_yggdrasil_urd_prefix}" NO_DEFAULT_PATH)
find_dependency(TBB CONFIG PATHS "${_yggdrasil_urd_prefix}" NO_DEFAULT_PATH)

# The dependency lookups above always run (consumers rely on this config to
# provide urd/Boost/fmt/gtl/TBB for their exported targets); only the target
# definition is guarded against repeated find_package calls.
if(NOT TARGET yggdrasil::yggdrasil)
    add_library(yggdrasil::yggdrasil INTERFACE IMPORTED)
    set_target_properties(yggdrasil::yggdrasil PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${_yggdrasil_prefix}/include"
        INTERFACE_COMPILE_FEATURES "cxx_std_20"
        INTERFACE_LINK_LIBRARIES "urd::urd;Boost::headers;Boost::json;fmt::fmt;gtl::gtl;TBB::tbb")
endif()


set(YGGDRASIL_NATIVE_PREFIX "${_yggdrasil_prefix}")
set(URD_NATIVE_PREFIX "${_yggdrasil_urd_prefix}")

unset(_yggdrasil_prefix)
unset(_yggdrasil_urd_prefix)
